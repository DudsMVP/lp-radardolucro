<style>
  body { font-family: Calibri, Arial, sans-serif; font-size: 11pt; color: #1a1a1a; margin: 2cm 2.5cm; }
  h1 { font-size: 20pt; color: #1a1a1a; border-bottom: 3px solid #c8a84a; padding-bottom: 6pt; margin-bottom: 4pt; }
  h2 { font-size: 14pt; color: #c8a84a; margin-top: 20pt; margin-bottom: 6pt; }
  h3 { font-size: 11pt; color: #1a1a1a; margin-top: 12pt; margin-bottom: 4pt; }
  .subtitle { font-size: 12pt; color: #555; margin-bottom: 4pt; }
  .meta { font-size: 10pt; color: #777; margin-bottom: 16pt; }
  table { border-collapse: collapse; width: 100%; margin: 10pt 0 16pt 0; }
  th { background-color: #1a1a1a; color: #c8a84a; padding: 6pt 10pt; text-align: left; font-size: 10pt; }
  td { border: 1px solid #ddd; padding: 5pt 10pt; font-size: 10pt; vertical-align: top; }
  tr:nth-child(even) td { background-color: #f9f9f9; }
  ul { margin: 4pt 0 10pt 0; padding-left: 18pt; }
  li { margin-bottom: 3pt; font-size: 10pt; }
  .divider { border: none; border-top: 1px solid #e0e0e0; margin: 18pt 0; }
  .script-block { background: #f6f4ef; border-left: 4px solid #c8a84a; padding: 10pt 14pt; margin: 8pt 0; font-size: 10pt; }
  .direction { color: #555; font-style: italic; font-size: 9.5pt; margin: 6pt 0 2pt 0; }
  .spoken { font-size: 10.5pt; margin: 2pt 0 8pt 0; }
  .file-tag { background: #1a1a1a; color: #c8a84a; padding: 2pt 7pt; font-size: 9pt; font-family: Courier, monospace; }
  .checklist li { list-style: none; padding-left: 0; }
  .checklist li::before { content: '\2610  '; font-size: 11pt; }
